# ============================================================
# Kali MCP Server - Environment Configuration Template
# ============================================================
# Copy this file to .env and adjust for your environment:
#     cp .env.example .env
# All values are optional - sensible defaults are used if unset.
# ============================================================

# ------------------------------------------------------------
# Server (unified: serves API + WebSocket + dashboard UI)
# ------------------------------------------------------------
# Port the server listens on
API_PORT=5001

# Bind address:  0.0.0.0 = reachable from the network, 127.0.0.1 = local only
API_IP=0.0.0.0

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# SQLite scan-history database. Relative paths are created next to the app.
# Examples:  scan_history.db  |  /home/kali/scan_history.db
DATABASE_PATH=scan_history.db

# Maximum scan-history records kept per tool
MAX_HISTORY=100

# ------------------------------------------------------------
# Behaviour
# ------------------------------------------------------------
# Per-command timeout in seconds
COMMAND_TIMEOUT=180

# How long (seconds) tool-availability checks are cached before re-running `which`
TOOL_STATUS_CACHE_TTL=60

# Enable Flask debug mode (0 = off, 1 = on)
DEBUG_MODE=0

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Flask secret key - CHANGE THIS in production
SECRET_KEY=change-me-in-production

# Allowed CORS origins ( * for development, specific domains for production )
CORS_ORIGINS=*

# ============================================================
# Notes:
# - This file is optional; defaults are used when it is absent.
# - Never commit your real .env (it is ignored via .gitignore).
# ============================================================
